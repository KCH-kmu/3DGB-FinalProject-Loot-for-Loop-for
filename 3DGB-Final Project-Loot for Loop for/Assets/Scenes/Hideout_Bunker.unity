  roleName: "\uC758\uBB34\uC2E4"
  dialogue:
  - "\uB2E4\uCE5C \uACF3\uC740 \uC5C6\uB098\uC694? \uC774\uACF3\uC5D0\uC11C\uB294 \uC7A0\uC2DC \uAE34\uC7A5\uC744 \uD480\uC5B4\uB3C4 \uAD1C\uCC2E\uC544\uC694. \uB2E4\uC74C \uCD9C\uBC1C \uC804\uC5D0\uB294 \uAF2D \uBAB8\uC744 \uB3CC\uBCF4\uC138\uC694."
  - "\uC5EC\uAE30\uB294 \uC758\uBB34\uC2E4\uC774\uC5D0\uC694. \uCE58\uB8CC\uC640 \uC758\uC57D\uD488 \uC11C\uBE44\uC2A4\uB294 \uC900\uBE44 \uC911\uC774\uB2C8, \uC624\uB298\uC740 \uD3B8\uD558\uAC8C \uC774\uC57C\uAE30\uB97C \uB098\uB220\uC694."
  interactionPoint: {fileID: 387035654}
  accent: {r: 0.64, g: 0.86, b: 0.71, a: 1}
