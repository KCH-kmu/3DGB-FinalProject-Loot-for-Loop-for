  npcId: bull
  displayName: "\uD669\uC18C"
  roleName: "\uC791\uC5C5\uC7A5"
  dialogue:
  - "\uC5B4\uC11C \uC624\uAC8C! \uB0A1\uC740 \uC7A5\uBE44\uB3C4 \uC798 \uC190\uBCF4\uBA74 \uC624\uB798 \uC4F8 \uC218 \uC788\uC9C0. \uC4F8 \uB9CC\uD55C \uBD80\uD488\uC744 \uBC1C\uACAC\uD558\uBA74 \uAE30\uC5B5\uD574 \uB450\uAC8C."
  - "\uC774\uACF3\uC740 \uC791\uC5C5\uC7A5\uC774\uB124. \uC81C\uC791\uACFC \uC218\uB9AC \uC11C\uBE44\uC2A4\uB294 \uC900\uBE44 \uC911\uC774\uC57C. \uC791\uC5C5\uB300\uAC00 \uC900\uBE44\uB418\uBA74 \uB2E4\uC2DC \uC774\uC57C\uAE30\uD558\uC138."
  interactionPoint: {fileID: 257033256}
  accent: {r: 0.96, g: 0.75, b: 0.42, a: 1}
